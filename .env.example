# ma-noti — ตัวอย่าง env ครบทุกตัวตามสเปก (ticket #2)
# คัดลอกเป็น .env แล้วเติมค่าจริง:  cp .env.example .env
# ห้าม commit ไฟล์ .env หรือใส่ secret/ข้อมูลจริง (ลูกค้า/หน่วยงาน/partner/อีเมล/contact) ลง repo — repo เป็น public
# ดูคู่มือ step-by-step: docs/setup-supabase.md

# ---- Supabase (โปรเจกต์ `ma-noti`, region Singapore) -----------------------
# Project URL จาก Dashboard > Project Settings > API Keys
SUPABASE_URL=https://REPLACE_WITH_PROJECT_REF.supabase.co
# anon key — สำหรับฝั่ง frontend (RLS กัน anon ไว้ ยังไม่ล็อกอิน = แตะไม่ได้)
SUPABASE_ANON_KEY=replace_with_anon_key
# service_role key — ใช้เฉพาะฝั่ง server/cron เท่านั้น (ข้าม RLS) ห้ามใช้ฝั่ง browser
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_secret_key

# ---- Google Sheet (อ่านอย่างเดียว; service account ถูกรับแชร์ชีตเป็น Viewer) --
# ใชจรง แต ticket #5 (cron อานทุกแท็บทุกเชา) — คูมือ step-by-step: docs/setup-google-sheet.md
GOOGLE_SHEET_ID=replace_with_google_sheet_id
# JSON key ของ Service Account เป็นสตริงบรรทัดเดียว (escape " ให้ถูก) — ไม่มีค่าจริงลง repo
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","replace":"with real JSON on one line"}

# ---- Email ผ่าน Brevo (ของ ticket #4 — ยังไม่ถูกใช้ใน ticket นี้) -------------
BREVO_API_KEY=replace_with_brevo_api_key

# ---- ป้องกัน endpoint ของ cron -----------------------------------------------
# สร้าง secret:  openssl rand -hex 32
# ทุกคำขอต้องแนบ Authorization: Bearer <CRON_SECRET> (Vercel Cron ส่งให้อัตโนมัติ)
CRON_SECRET=replace_with_long_random_secret

# ---- โหมดรัน: DRY_RUN เป็นค่าเริ่มต้นเสมอ (คำนวณ+เขียน log แต่ไม่ส่งจริง) ----
# ค่าอื่นนอกจาก false/0/off ถือนับเป็น DRY_RUN (safe default — ไม่ส่งของจริง)
# ปดแลว (false): ทอรันเต็มรูปแบบ + เขียน log marker dry_run=false — แตนี่ยังไมมีตวสงจริง (Brevo/Discord/Telegram มาใน ticket #10)
DRY_RUN=true
